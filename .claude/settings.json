{
  "permissions": {
    "deny": [
      "Read(./.secrets/**)",
      "Edit(./.secrets/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-secrets.sh",
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
